<Project Sdk="Microsoft.NET.Sdk">

  <!--
    App Shell (see docs/ai/ARCHITECTURE.md) — the process that owns the desktop assistant's lifetime.

    This is the first assembly in the repo that *drives* the pipeline rather than being driven by a
    verification host. It exists because two decisions deliberately left their wiring here rather than
    inside a module:

      * DEC-010 — the Context Orchestrator does not subscribe to GlobalHotkeyMonitor.Pressed; "Both
        gaps close in the app shell (Voice pipeline + this wiring)". The shell is that host.
      * DEC-011 — the Screen Overlay reports a failure but "the future shell decides what the user
        sees". The shell is that decision-maker.

    No direct PackageReference, like every module. One package arrives TRANSITIVELY since DEC-027:
    Microsoft.Web.WebView2, through LessonSession -> LessonSurface, the single NuGet exception DEC-020/
    DEC-025 already accepted for the lesson cards. The core modules (hotkey, capture, ES, Vision) stay
    zero-NuGet; SH-2 still greps this file for a direct reference. WinUI 3 / Windows App SDK remains the
    eventual shell direction (DEC-011) and is deferred again by DEC-012 — nothing in the pipeline
    renders a window today (the overlay already is the UI, and it is Win32), and taking the SDK here
    would mean the repo's first external package plus a packaging story, and would put an
    activation-taking UI thread next to an overlay whose whole contract is WS_EX_NOACTIVATE.

    The one thing this assembly owns that no module may own is process-global state: PerMonitorV2 DPI
    awareness (DEC-004 makes that the host's decision) and the single ScreenCaptureService whose monitor
    topology is shared by both the orchestrator and the overlay.

    TargetFramework is the highest in the repo: it must consume PixelRect/MonitorCapture from
    ScreenCapture (net8.0-windows10.0.22621.0) and the hotkey monitor (net8.0-windows, which a
    higher platform version may reference).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.App</RootNamespace>
    <AssemblyName>HeyGanesh.App</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Five references, and they are the whole pipeline: the monitor raises the trigger, Voice turns
      that trigger's speech into the question, the orchestrator answers it, the overlay shows the
      answer, and the Tutor Engine teaches from it (DEC-016 — the shell wires the leg to a seam that
      still has no live client; DEC-015 leaves the provider to the owner). ScreenCapture,
      ElementSelection and Vision arrive transitively through ContextOrchestrator and are used
      directly here — the same stance tools/ContextOrchestratorSmoke takes, where one reference is
      documented as enough. The Tutor reference is direct and deliberate: the shell is the ONLY
      mapper between a verdict and a teaching request, and the Tutor itself references nothing.
    -->
    <ProjectReference Include="..\..\Platform\HeyGanesh.GlobalHotkeyMonitor\HeyGanesh.GlobalHotkeyMonitor.csproj" />
    <ProjectReference Include="..\HeyGanesh.Voice\HeyGanesh.Voice.csproj" />
    <ProjectReference Include="..\..\Intelligence\HeyGanesh.ContextOrchestrator\HeyGanesh.ContextOrchestrator.csproj" />
    <ProjectReference Include="..\..\Foundation\HeyGanesh.Abstractions\HeyGanesh.Abstractions.csproj" />
    <ProjectReference Include="..\..\Platform\HeyGanesh.ScreenOverlay\HeyGanesh.ScreenOverlay.csproj" />
    <ProjectReference Include="..\..\Intelligence\HeyGanesh.TutorEngine\HeyGanesh.TutorEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The lesson leg (DEC-027): LessonSession runs one lesson turn (plan -> cards -> play); the shell
      only maps the verdict to grounding and hands Voice in as the speaker. OpenAiCompat is the adapter
      CreateLessonPlanner() builds the lesson model from (DeepSeek, DEEPSEEK_API_KEY via
      EnvironmentSecretStore); it brings Providers.Core and Security with it.
    -->
    <ProjectReference Include="..\HeyGanesh.LessonSession\HeyGanesh.LessonSession.csproj" />
    <ProjectReference Include="..\..\Providers\HeyGanesh.Providers.OpenAiCompat\HeyGanesh.Providers.OpenAiCompat.csproj" />
    <!-- The key commands use Security's KeyRing directly (DEC-045), so the reference is stated, not inherited. -->
    <ProjectReference Include="..\..\Foundation\HeyGanesh.Security\HeyGanesh.Security.csproj" />
    <!-- Each taught turn becomes a note in the local store (DEC-058/DEC-059); zero NuGet, Windows' own SQLite. -->
    <ProjectReference Include="..\..\Foundation\HeyGanesh.Notes\HeyGanesh.Notes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The routing leg (DEC-036): TurnRouter asks Jev how a turn is taught; PartLibrary gives it the
      models' titles and subjects to offer. Both are pure policy/data with no NuGet.
    -->
    <ProjectReference Include="..\..\Intelligence\HeyGanesh.TurnRouter\HeyGanesh.TurnRouter.csproj" />
    <ProjectReference Include="..\..\Intelligence\HeyGanesh.PartLibrary\HeyGanesh.PartLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The tray (DEC-052) runs this same composition through ShellHost.RunAsync(args, stop, hookLive) instead of
      building the pipeline twice; its verification host drives that seam in-process. The shell stays internal.
    -->
    <InternalsVisibleTo Include="HeyGanesh.Tray" />
    <InternalsVisibleTo Include="HeyGanesh.Tools.TraySmoke" />
  </ItemGroup>

  <!-- Same MSB3277 trap as LessonSurface: the WebView2 package's WPF reference flows to every consumer. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
