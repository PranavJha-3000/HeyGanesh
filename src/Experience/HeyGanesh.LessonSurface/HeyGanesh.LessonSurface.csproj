<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lesson Surface (FEATURE-007 Phase 3, DEC-020) — the real ILessonCanvas.

    Validated lessons (DEC-023) are drawn on paper-style cards: one borderless, top-most, never-
    activated, capture-excluded window per declared surface, each hosting a WebView2 page that builds
    DOM/SVG from beat messages. Marks on the student's own screen go to the native, click-through
    ScreenOverlay instead. Plot points arrive already computed (PlotExpression); the page never
    evaluates anything from the model.

    The ONE documented NuGet exception in HeyGanesh (DEC-020): Microsoft.Web.WebView2, pinned. Core
    modules stay zero-NuGet; LSU-1 (tools/LessonSurfaceSmoke - -assert-source) pins this to exactly
    one package at this version. The page ships as content files (Page/ -> LessonPage/ in the output)
    served from a virtual host with a CSP that blocks the network; nothing is fetched from a CDN.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HeyGanesh.LessonSurface</RootNamespace>
    <AssemblyName>HeyGanesh.LessonSurface</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Intelligence\HeyGanesh.VisualLessonEngine\HeyGanesh.VisualLessonEngine.csproj" />
    <ProjectReference Include="..\..\Platform\HeyGanesh.ScreenOverlay\HeyGanesh.ScreenOverlay.csproj" />
    <ProjectReference Include="..\..\Platform\HeyGanesh.ScreenCapture\HeyGanesh.ScreenCapture.csproj" />
    <ProjectReference Include="..\..\Foundation\HeyGanesh.Abstractions\HeyGanesh.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Page\**\*" Link="LessonPage\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The WebView2 package references its WPF control assembly unconditionally for .NET 5+, which
    conflicts with the in-box WindowsBase (MSB3277). Cards are WinForms-hosted, so that one
    reference is removed rather than the warning silenced.
  -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
