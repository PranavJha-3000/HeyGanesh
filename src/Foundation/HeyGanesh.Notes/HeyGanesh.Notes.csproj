<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Notes Persistence (DEC-058): a local store of what was asked and taught, one row per turn, in
    %LOCALAPPDATA%/HeyGanesh/notes.db. SQLite through Windows' own winsqlite3.dll (System32, Windows 10 and 11) by
    P/Invoke, as BUILD-PLAYBOOK D3 recommends: zero PackageReference, like the core modules, and no ProjectReference.
    A lesson plan is stored as its JSON text, so this module never needs the lesson engine; it sits in Foundation
    and anything above may use it.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Notes</RootNamespace>
    <AssemblyName>HeyGanesh.Notes</AssemblyName>
  </PropertyGroup>

</Project>
