<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vision / Coordinate Detection (see docs/ai/ARCHITECTURE.md).

    Deliberately dependency-free and UI-free, mirroring ScreenCapture (DEC-004): there is
    no PackageReference here. System.Net.Http and System.Text.Json ship in the .NET 8 shared
    framework, so the only other input this project needs is the Windows.Graphics.* metadata
    reference pack, which it inherits transitively from the HeyGanesh.ScreenCapture dependency
    through the shared TargetFramework. The module therefore composes with ScreenCapture without
    taking on any additional NuGet of its own.

    NOTE on the coordinate surface: the result type reuses HeyGanesh.ScreenCapture.PixelRect
    for screen-space boxes so that the numbers Vision returns sit in exactly the pixel space
        MonitorInfo.Bounds, that is the single, shared coordinate contract between the two
    modules. System.Drawing.RectangleF/Rectangle were intentionally avoided because
    System.Drawing.Common is not in the shared framework and would require a PackageReference.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Vision</RootNamespace>
    <AssemblyName>HeyGanesh.Vision</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\HeyGanesh.ScreenCapture\HeyGanesh.ScreenCapture.csproj" />
    <ProjectReference Include="..\..\Foundation\HeyGanesh.Abstractions\HeyGanesh.Abstractions.csproj" />
  </ItemGroup>

</Project>