<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification host for the Element Selection module (see docs/ai/ARCHITECTURE.md).

    Not product code: it exists so the module can be proven end-to-end against a real window and a real
    Jev call before any app shell, Context Orchestrator or Screen Overlay exists. Delete once the app
    can host Element Selection itself (see docs/ai/HANDOVER.md). It mirrors tools/VisionSmoke.csproj:
    same dependency-free stance (no PackageReference), and the same per-monitor-v2 DPI awareness
    requirement — physical pixels everywhere.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Tools.ElementSelectionSmoke</RootNamespace>
    <AssemblyName>HeyGanesh.Tools.ElementSelectionSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Perception\HeyGanesh.ElementSelection\HeyGanesh.ElementSelection.csproj" />
      <ProjectReference Include="..\..\src\Foundation\HeyGanesh.Abstractions\HeyGanesh.Abstractions.csproj" />
</ItemGroup>

</Project>
