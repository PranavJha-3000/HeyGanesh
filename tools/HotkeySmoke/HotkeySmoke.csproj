<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual verification host for the Global Hotkey Monitor module.
    Not product code: it exists so the module can be proven on a real desktop before any
    app shell, Context Orchestrator or UI exists. Delete it once the app can host the
    module itself (see docs/ai/HANDOVER.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Tools.HotkeySmoke</RootNamespace>
    <AssemblyName>HeyGanesh.Tools.HotkeySmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Platform\HeyGanesh.GlobalHotkeyMonitor\HeyGanesh.GlobalHotkeyMonitor.csproj" />
  </ItemGroup>

</Project>
