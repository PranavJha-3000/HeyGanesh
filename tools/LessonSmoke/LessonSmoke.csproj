<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification host for the Visual Lesson Engine's VisualPlan contract (see
    docs/ai/features/FEATURE-007.md, Phase 1).

    Not product code: it proves offline that model-authored lesson JSON is parsed without throwing,
    held to the v1 limits, checked for reference integrity, and degraded to speech (or plain text)
    instead of being lost. Golden fixtures live in fixtures/ and are copied next to the EXE.
    Mirrors tools/TutorSmoke: same dependency-free stance, same PASS/FAIL row pattern.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Tools.LessonSmoke</RootNamespace>
    <AssemblyName>HeyGanesh.Tools.LessonSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Intelligence\HeyGanesh.VisualLessonEngine\HeyGanesh.VisualLessonEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
