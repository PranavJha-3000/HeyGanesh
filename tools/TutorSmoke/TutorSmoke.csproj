<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification host for the Tutor Engine (see docs/ai/ARCHITECTURE.md).

    Not product code: it exists so the teaching seam can be proven offline — prompt contract,
    untrusted-data labeling, visual caps, error-family pass-through, cancellation, API-surface
    audit — with fakes and recorded completions, no provider, no key, no network. Mirrors
    tools/VoiceSmoke: same dependency-free stance, same fake-seam pattern.

    What it deliberately does NOT claim (TU-5's honest scope): a fake cannot prove a real model's
    resistance to prompt injection — that is a future live row, recorded so in TEST-CHECKLIST.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeyGanesh.Tools.TutorSmoke</RootNamespace>
    <AssemblyName>HeyGanesh.Tools.TutorSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Intelligence\HeyGanesh.TutorEngine\HeyGanesh.TutorEngine.csproj" />
  </ItemGroup>

</Project>